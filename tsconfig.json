{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"],
  "//": "src/client is checked by tsconfig.client.json -- it needs lib.DOM, which conflicts with @cloudflare/workers-types.",
  "exclude": ["src/client"]
}
